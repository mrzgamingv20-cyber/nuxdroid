<shortcuts xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Launcher shortcuts of the NuxDroid shell. There is no terminal
         shortcut: the shell has no terminal UI, commands run in the
         background from the desktop setup. -->

    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_settings"
        android:shortcutShortLabel="@string/action_open_settings"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nuxdroid"
            android:targetClass="com.termux.app.activities.SettingsActivity"
            android:name="android.shortcut.conversation"/>
    </shortcut>

</shortcuts>
