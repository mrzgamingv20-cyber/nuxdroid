<?xml version="1.0" encoding="utf-8"?>
<!-- One package row: typographic hierarchy only, install is a quiet text action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="24dp"
    android:paddingTop="16dp"
    android:paddingRight="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/packages_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nux_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/packages_item_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nux_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/packages_item_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:textColor="@color/nux_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/packages_item_install"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:minWidth="0dp"
        android:paddingLeft="12dp"
        android:paddingRight="0dp"
        android:stateListAnimator="@null"
        android:text="@string/packages_install_action"
        android:textAllCaps="false"
        android:textColor="@color/nux_text"
        android:textSize="13sp" />
</LinearLayout>
