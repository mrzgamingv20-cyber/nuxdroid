<?xml version="1.0" encoding="utf-8"?>
<!-- Bootstrap: only appears when the Linux prefix is missing or broken.
     Shows an extract‐progress bar with percentages and phase text, then hands
     over to the dashboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nux_bg"
    android:orientation="vertical"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/bootstrap_progress_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/bootstrap_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/bootstrap_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="0%"
            android:textColor="@color/nux_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bootstrap_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/bootstrap_phase_preparing"
            android:textColor="@color/nux_text_muted"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bootstrap_error_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bootstrap_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:textColor="@color/nux_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/bootstrap_retry"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bootstrap_retry"
            android:layout_gravity="center" />

    </LinearLayout>

</LinearLayout>