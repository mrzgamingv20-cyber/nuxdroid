<?xml version="1.0" encoding="utf-8"?>
<!-- Home — editorial page inside an emulator window skin.
     The outer layout is the desktop sheet; the framed window holds the
     title bar (window controls), the editorial content and the flat nav.
     Content stays card-less: hairline rules and type scale only.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nux_bg"
    android:orientation="vertical">

    <!-- Emulator window frame (rounded, hairline border, clipped corners) -->
    <LinearLayout
        android:id="@+id/emulator_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/bg_emulator_frame"
        android:clipToOutline="true"
        android:orientation="vertical">

        <!-- Window title bar: app name + minimize / maximize / close -->
        <LinearLayout
            android:id="@+id/emulator_toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_emulator_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:text="@string/application_name"
                android:textColor="@color/nux_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/emulator_btn_minimize"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/emulator_minimize"
                android:padding="15dp"
                android:src="@drawable/ic_win_minimize"
                android:tint="@color/nux_text_muted" />

            <ImageView
                android:id="@+id/emulator_btn_maximize"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/emulator_maximize"
                android:padding="15dp"
                android:src="@drawable/ic_win_maximize"
                android:tint="@color/nux_text_muted" />

            <ImageView
                android:id="@+id/emulator_btn_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/emulator_close"
                android:padding="15dp"
                android:src="@drawable/ic_win_close"
                android:tint="@color/nux_text_muted" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/nux_hairline" />

        <!-- Editorial content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/application_name"
                    android:textColor="@color/nux_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dashboard_tagline"
                    android:textColor="@color/nux_text_muted"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/nux_hairline" />

                <!-- Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_status_card_title"
                        android:textColor="@color/nux_text_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/dashboard_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.02"
                            android:textColor="@color/nux_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <!-- Green dot = Linux ready, grey = not ready -->
                        <View
                            android:id="@+id/dashboard_status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_nux_dot_idle"
                            android:contentDescription="@string/dashboard_status_card_title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dashboard_status_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/nux_text_muted"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Primary action: white pill, the visual focus -->
                        <Button
                            android:id="@+id/dashboard_quick_terminal"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_nux_button"
                            android:fontFamily="sans-serif-medium"
                            android:minWidth="0dp"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:stateListAnimator="@null"
                            android:text="@string/dashboard_open_terminal"
                            android:textAllCaps="false"
                            android:textColor="@color/nux_on_accent"
                            android:textSize="14sp" />

                        <!-- Secondary action: outline button so it reads as a button -->
                        <Button
                            android:id="@+id/dashboard_quick_update"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_nux_button_tonal"
                            android:fontFamily="sans-serif-medium"
                            android:minWidth="0dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:stateListAnimator="@null"
                            android:text="@string/dashboard_quick_update"
                            android:textAllCaps="false"
                            android:textColor="@color/nux_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="28dp"
                    android:background="@color/nux_hairline" />

                <!-- Desktop milestone: compact roadmap row, not a full block -->
                <LinearLayout
                    android:id="@+id/dashboard_tile_desktop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_desktop_unavailable_desc"
                        android:textColor="@color/nux_text_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/dashboard_tile_desktop_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/dashboard_desktop_badge"
                        android:textColor="@color/nux_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Flexible spacer: keeps the meta line at the bottom instead
                     of stacking everything at the top -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/nux_hairline" />

                <!-- Quiet meta line: version · storage used -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dashboard_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/nux_text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dashboard_meta_separator"
                        android:textColor="@color/nux_text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/dashboard_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/nux_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/nux_hairline" />

        <!-- Flat navigation bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/dashboard_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nux_bg"
            android:elevation="0dp"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/nux_nav_item"
            app:itemRippleColor="@color/nux_ripple"
            app:itemTextColor="@color/nux_nav_item"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_dashboard_nav" />
    </LinearLayout>
</LinearLayout>
