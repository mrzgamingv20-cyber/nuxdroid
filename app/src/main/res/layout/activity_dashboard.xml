<?xml version="1.0" encoding="utf-8"?>
<!--
  Beranda — editorial layout.

  No cards, no badges, no micro-labels, no monospace. Sections are separated by
  one hairline rule and by spacing; the only chrome is the single accent button
  and the flat navigation bar. Type does the hierarchy work.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nux_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="28dp"
            android:paddingRight="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/application_name"
                android:textColor="@color/nux_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dashboard_tagline"
                android:textColor="@color/nux_text_muted"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/nux_hairline" />

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_status_card_title"
                    android:textColor="@color/nux_text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dashboard_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/nux_text"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/dashboard_status_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_nux_dot_idle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dashboard_status_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/nux_text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/dashboard_quick_terminal"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_nux_button"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="0dp"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp"
                        android:stateListAnimator="@null"
                        android:text="@string/dashboard_open_terminal"
                        android:textAllCaps="false"
                        android:textColor="@color/nux_on_accent"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/dashboard_quick_update"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="0dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:stateListAnimator="@null"
                        android:text="@string/dashboard_quick_update"
                        android:textAllCaps="false"
                        android:textColor="@color/nux_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="@color/nux_hairline" />

            <!-- Desktop milestone -->
            <LinearLayout
                android:id="@+id/dashboard_tile_desktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_tile_desktop"
                        android:textColor="@color/nux_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dashboard_tile_desktop_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_desktop_badge"
                        android:textColor="@color/nux_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/dashboard_desktop_unavailable_desc"
                    android:textColor="@color/nux_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/nux_hairline" />

            <!-- Quiet meta line: version and prefix state, no labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dashboard_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/nux_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/dashboard_meta_separator"
                    android:textColor="@color/nux_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dashboard_prefix_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/nux_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Flat navigation bar: same surface as the page, one hairline above it -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nux_hairline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/dashboard_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nux_bg"
        android:elevation="0dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/nux_nav_item"
        app:itemRippleColor="@color/nux_ripple"
        app:itemTextColor="@color/nux_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_dashboard_nav" />
</LinearLayout>
