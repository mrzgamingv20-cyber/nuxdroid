<?xml version="1.0" encoding="utf-8"?>
<!-- Frame jendela emulator: persegi panjang bergaris tipis dengan sudut
     melengkarkan. Dipakai sebagai background kontainer (bukan foreground,
     agar tidak menutupi konten). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nux_bg" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="@color/nux_hairline" />
</shape>
