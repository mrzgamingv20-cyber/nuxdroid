<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol sekunder: outline pill agar terbaca sebagai tombol,
     bukan teks biasa. Ripple tanpa pergeseran layout. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/nux_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/nux_outline" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</ripple>
