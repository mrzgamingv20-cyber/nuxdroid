    <item
        android:id="@+id/nav_xserver"
        android:icon="@drawable/ic_dashboard_xserver"
        android:title="@string/nav_xserver" />

    <item
        android:id="@+id/nav_settings"
        android:icon="@drawable/ic_dashboard_settings"
        android:title="@string/nav_settings" />

</menu>
