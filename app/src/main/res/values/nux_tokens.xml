<?xml version="1.0" encoding="utf-8"?>
<!--
  NuxDroid shell tokens.

  Editorial direction: the page is ink on a dark sheet. Hierarchy comes from
  type size and spacing, not from stacked cards, borders and shadows. One
  accent (white) and one hairline rule are the only chrome allowed.

  Contrast on the page background (#08080A):
    text        #F2F2F4  ~18:1
    muted       #BFC1C8  ~10:1   (sunlight readable)
    on accent   #0A0A0B on #F2F2F4  ~18:1
-->
<resources>
    <color name="nux_bg">#08080A</color>
    <!-- Only raised surface in the shell: dialogs. Everything else is flat. -->
    <color name="nux_surface">#141418</color>
    <color name="nux_text">#F2F2F4</color>
    <color name="nux_text_muted">#BFC1C8</color>
    <color name="nux_accent">#F2F2F4</color>
    <color name="nux_on_accent">#0A0A0B</color>
    <color name="nux_ripple">#1FFFFFFF</color>
    <color name="nux_hairline">#22222A</color>
    <!-- Outline stroke for secondary (tonal) buttons: visible on #08080A. -->
    <color name="nux_outline">#3A3B45</color>
    <!-- Status dots: green = Linux ready, grey = not ready yet. -->
    <color name="nux_dot_active">#3DDC84</color>
    <color name="nux_dot_idle">#6E6F77</color>
</resources>
