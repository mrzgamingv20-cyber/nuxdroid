<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!--
      NuxDroid shell theme (Beranda, Paket, Pengaturan).

      The shell is always dark, even when the system is in light mode: the
      surfaces, text and accent tokens are fixed in values/nux_tokens.xml, so
      every Material attribute resolves to the same dark palette in both modes.
      This keeps the shell monochrome and readable on OLED screens, and avoids
      the loud dynamic primary blocks that the previous dashboard used.
    -->
    <style name="Theme.NuxDroid.Shell" parent="Theme.BaseActivity.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/nux_bg</item>
        <item name="android:colorBackground">@color/nux_bg</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/nux_surface</item>
        <item name="colorOnSurface">@color/nux_text</item>
        <item name="colorOnBackground">@color/nux_text</item>

        <!-- Monochrome accent: white pill, black content -->
        <item name="colorPrimary">@color/nux_accent</item>
        <item name="colorPrimaryVariant">@color/nux_accent</item>
        <item name="colorOnPrimary">@color/nux_on_accent</item>
        <item name="colorPrimaryDark">@color/nux_bg</item>
        <item name="colorSecondary">@color/nux_text_muted</item>
        <item name="colorSecondaryVariant">@color/nux_text_muted</item>
        <item name="colorOnSecondary">@color/nux_bg</item>
        <item name="colorAccent">@color/nux_text</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/nux_text</item>
        <item name="android:textColorSecondary">@color/nux_text_muted</item>

        <!-- System chrome -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/nux_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/nux_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Tab switch crossfade: the shell destinations are activities, so the
             transition is set here instead of per startActivity call. -->
        <item name="android:windowAnimationStyle">@style/Animation.NuxDroid.Tab</item>
    </style>

    <!-- TermuxApp Light DarkActionBar theme. -->
    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.BaseActivity.Light.DarkActionBar"/>
    <!-- TermuxApp Light NoActionBar theme. -->
    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.BaseActivity.Light.NoActionBar"/>

    <!-- TermuxApp DayNight DarkActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar"/>
    <!-- TermuxApp DayNight NoActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.NoActionBar"/>


    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>

        <item name="android:windowBackground">@color/black</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Light</item>
        <item name="termuxActivityDrawerBackground">@color/white</item>
        <item name="termuxActivityDrawerImageTint">@color/black</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">@color/white</item>
        <item name="extraKeysButtonActiveTextColor">@color/red_400</item>
        <item name="extraKeysButtonBackgroundColor">@color/black</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/grey_500</item>
    </style>

</resources>
