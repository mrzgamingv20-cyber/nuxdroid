<?xml version="1.0" encoding="utf-8"?>
<!-- Shell-only styles: the dialog window and the tab transition. -->
<resources>

    <!-- Dialog window. The surface, corners and padding live in
         res/layout/dialog_nux.xml, so the window itself is transparent and only
         keeps the floating behaviour and the dim behind it. -->
    <style name="Theme.NuxDroid.Dialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <!-- Tab switch: crossfade, so a tab change does not slide a whole screen in
         from the side like a push navigation. -->
    <style name="Animation.NuxDroid.Tab" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/nux_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/nux_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/nux_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/nux_fade_out</item>
    </style>
</resources>
